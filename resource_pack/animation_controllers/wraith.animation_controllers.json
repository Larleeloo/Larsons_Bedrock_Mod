{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.wraith.general": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking"
            }
          ]
        },
        "attacking": {
          "animations": [
            "idle",
            "attack"
          ],
          "blend_transition": 0.2,
          "transitions": [
            {
              "default": "!query.is_delayed_attacking"
            }
          ]
        }
      }
    }
  }
}
